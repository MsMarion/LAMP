# Copy to a file named .env ONE FOLDER ABOVE the web root and fill in real values.
# On the droplet: /var/www/.env when the site lives in /var/www/html.
# Never commit the real .env; .gitignore blocks it.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lamp_project
DB_USER=lampuser
DB_PASSWORD="change-me"
DB_CHARSET=utf8mb4
