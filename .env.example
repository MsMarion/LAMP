# Copy this file to .env and fill in real values. Never commit the real .env.
#   Local Docker:  .env in the project folder (docker-compose.yml mounts it).
#   Droplet:       /var/www/.env, one folder ABOVE the web root /var/www/html.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lamp_project
DB_USER=lampuser
DB_PASSWORD="change-me"
DB_CHARSET=utf8mb4

# Local Docker only: host port for the website.
WEB_PORT=8081
