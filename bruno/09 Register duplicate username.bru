meta {
  name: Register duplicate username
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/register.php
  body: json
  auth: none
}

body:json {
  {
    "username": "{{newUsername}}",
    "password": "{{seedPassword}}",
    "full_name": "CI Test User"
  }
}

tests {
  test("409 Conflict", function() {
    expect(res.getStatus()).to.equal(409);
  });
}
