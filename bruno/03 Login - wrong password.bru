meta {
  name: Login - wrong password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/login.php
  body: json
  auth: none
}

body:json {
  {
    "username": "alice",
    "password": "wrong-password"
  }
}

tests {
  test("401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });
  test("generic message that doesn't reveal which field was wrong", function() {
    expect(res.getBody().error).to.equal("Invalid username or password");
  });
}
